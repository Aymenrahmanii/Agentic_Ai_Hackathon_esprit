# Copy to .env and fill in. Never commit .env.

# Default: any OpenAI-compatible endpoint. Groq shown; get a key at console.groq.com.
AFI_PROVIDER=openai_compat
AFI_BASE_URL=https://api.groq.com/openai/v1
AFI_API_KEY=
AFI_MODEL=openai/gpt-oss-120b

# Other OpenAI-compatible endpoints (change AFI_BASE_URL, AFI_API_KEY and AFI_MODEL):
#   Gemini:      https://generativelanguage.googleapis.com/v1beta/openai/
#   OpenRouter:  https://openrouter.ai/api/v1
#   Ollama:      http://localhost:11434/v1   (any non-empty AFI_API_KEY)

# Anthropic instead:
# AFI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AFI_MODEL=claude-opus-5-5
# AFI_EFFORT=low

# Optional
# AFI_MAX_TOKENS=4000
# AFI_MAX_AGENT_STEPS=6

# Used by docker-compose.yml for the local Neo4j container
NEO4J_PASSWORD=
