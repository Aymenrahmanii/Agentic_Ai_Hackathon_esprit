# Copy to .env and fill in. Never commit .env.

# Main model provider, and the provider used when it is rate-limited or down.
# Presets: gemini, groq. Leave AFI_FALLBACK_PROVIDER empty to disable the fallback.
# AFI_PROVIDER=replay answers the recorded demo questions with no network (offline demo).
AFI_PROVIDER=gemini
AFI_FALLBACK_PROVIDER=groq

# Gemini: key from aistudio.google.com. Free-tier data is used by Google to improve its
# products, so keep real investor data off the free tier.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# Groq: key from console.groq.com. Free tier allows about 200,000 tokens a day.
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# Any other OpenAI-compatible endpoint (OpenRouter, Ollama, ...):
# AFI_PROVIDER=openai_compat
# AFI_BASE_URL=http://localhost:11434/v1
# AFI_API_KEY=
# AFI_MODEL=

# Anthropic instead:
# AFI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# AFI_MODEL=claude-opus-5-5
# AFI_EFFORT=low

# Optional
# AFI_MAX_TOKENS=4000
# AFI_MAX_AGENT_STEPS=6

# Where zones, lots and procedures come from: memory (data/seed.json) or neo4j.
# For neo4j: `uv sync --extra graph`, start the container, then load it (see README).
AFI_STORE=memory
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# Also used by docker-compose.yml for the local Neo4j container
NEO4J_PASSWORD=
